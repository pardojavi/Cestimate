# Cestimate — variables de entorno de la API (apps/api)
# Copia este archivo a .env en la raíz del repo y ajusta los valores.

# Puerto del servidor API
PORT=8787

# Orígenes permitidos (CORS). En producción, la URL de GitHub Pages:
# https://TU-USUARIO.github.io/cestimate
CORS_ORIGIN=*

# Ruta del archivo SQLite (se crea automáticamente)
DATABASE_PATH=./data/cestimate.db

# TTL de caché en horas para búsquedas y catálogo (por defecto 12)
TTL_HOURS=12

# User-Agent identificable enviado a las tiendas
USER_AGENT=Cestimate/1.0 (+https://github.com/TU-USUARIO/cestimate)

# Código postal por defecto (si no hay ninguno guardado en ajustes)
DEFAULT_POSTAL_CODE=28001
