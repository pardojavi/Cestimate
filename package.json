{
  "name": "cestimate",
  "private": true,
  "version": "0.1.0",
  "description": "Cestimate — Compara tu cesta, no tus precios.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "iconos": "node scripts/generar-iconos.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
